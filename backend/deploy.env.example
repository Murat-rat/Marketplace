# Copy to deploy.env and fill in. deploy.env is git-ignored: it holds passwords.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

AWS_REGION=us-east-1

# Network (see docs/SETUP.md). Private subnets of the VPC where the RDS instances live.
SUBNET_IDS=subnet-aaaa,subnet-bbbb
LAMBDA_SECURITY_GROUP_ID=sg-xxxx

# Signs the login tokens. At least 32 random characters.
JWT_SECRET=CHANGE_ME

# RDS #1 - core business
CORE_DB_HOST=CHANGE_ME.xxxxxx.us-east-1.rds.amazonaws.com
CORE_DB_NAME=marketplace_core

# RDS #2 - sensitive data
SECURE_DB_HOST=CHANGE_ME.xxxxxx.us-east-1.rds.amazonaws.com
SECURE_DB_NAME=marketplace_sensitive

# Per-function MySQL users (created by backend/sql/db_users_*.sql)
AUTH_CORE_DB_USER=app_auth
AUTH_CORE_DB_PASSWORD=CHANGE_ME
AUTH_SECURE_DB_USER=app_auth_s
AUTH_SECURE_DB_PASSWORD=CHANGE_ME
CATALOG_CORE_DB_USER=app_catalog
CATALOG_CORE_DB_PASSWORD=CHANGE_ME

# Private S3 bucket for product images (optional until image upload exists)
# IMAGES_BUCKET=marketplace-images-xxxx
